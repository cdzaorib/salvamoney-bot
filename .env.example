# Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Firebase
FIREBASE_DB_URL=https://porquimdocd-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=porquimdocd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@porquimdocd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
# Alternativa recomendada para Railway: cole o JSON da service account em base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Groq
GROQ_API_KEY=cole_sua_chave_da_groq
GROQ_MODEL=openai/gpt-oss-20b

# App
NODE_ENV=production
MONTH_INDEX_MODE=zero
TZ=America/Sao_Paulo
JSON_LIMIT=25mb
WEBHOOK_TOKEN=
DASHBOARD_TOKEN=
LOG_SENSITIVE_DATA=false
WEEKLY_REPORT_SCHEDULER_ENABLED=true

# ─── Feature flags (produção exige "true" explícito; qualquer outro valor desliga) ───
# Cada subsistema pode ser desligado sozinho para rollback, sem novo deploy de código.
FEATURE_CONVERSATIONAL_AI=false
FEATURE_PERSONALITIES=false
FEATURE_FRIENDS=false
FEATURE_SPLITS=false
FEATURE_CARDS=false
FEATURE_FINANCIAL_ADVISOR=false
FEATURE_INVESTMENT_RESEARCH=false
FEATURE_PROACTIVE_MESSAGES=false

# ─── DeepSeek (interpretação complexa e redação) ───
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=2500
DEEPSEEK_MAX_TOKENS=600
# Versão do aviso de consentimento. Ao mudar, todos precisam aceitar de novo.
AI_CONSENT_VERSION=2026-09-v1

# ─── Groq (Whisper para áudio + GPT-OSS como fallback textual) ───
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_TIMEOUT_MS=2500
GROQ_MAX_RETRIES=1
GROQ_AUDIO_TIMEOUT_MS=14000
GROQ_VISION_TIMEOUT_MS=14000
MEDIA_DOWNLOAD_TIMEOUT_MS=5000
AI_LEGACY_TIMEOUT_MS=3000

# ─── Brave Search (pesquisa de investimentos, só quando o usuário pede) ───
BRAVE_API_KEY=
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_TIMEOUT_MS=5000
RESEARCH_COUNTRY=BR
RESEARCH_SEARCH_LANG=pt-br
RESEARCH_RESULTS_PER_QUERY=8

# ─── Limites, timeouts e circuit breaker ───
AI_TEXT_DEADLINE_MS=3000
AI_RESEARCH_DEADLINE_MS=12000
AI_MAX_RETRIES=1
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000
AI_CONTEXT_MAX_MESSAGES=6
AI_CONTEXT_TTL_MS=86400000

# ─── Orçamento mensal de serviços externos (R$) ───
AI_MONTHLY_BUDGET_BRL=60
AI_BUDGET_DEEPSEEK_BRL=35
AI_BUDGET_SEARCH_BRL=10
AI_BUDGET_RESERVE_BRL=15
AI_BUDGET_ALERT_PERCENT=80
# WhatsApp do administrador que recebe o alerta de 80% e de limite (somente dígitos).
ADMIN_PHONE=

# ─── Tarifas (sem valor padrão no código) ───
# Preencha com os preços vigentes de cada provedor. Sem tarifa e câmbio a chamada
# fica bloqueada (inclusive Groq: texto, áudio e imagem), para o teto ser rígido.
USD_BRL_RATE=
DEEPSEEK_PRICE_INPUT_USD_PER_MTOK=
DEEPSEEK_PRICE_OUTPUT_USD_PER_MTOK=
GROQ_FALLBACK_PRICE_INPUT_USD_PER_MTOK=
GROQ_FALLBACK_PRICE_OUTPUT_USD_PER_MTOK=
GROQ_LEGACY_PRICE_INPUT_USD_PER_MTOK=
GROQ_LEGACY_PRICE_OUTPUT_USD_PER_MTOK=
# Whisper é cobrado por hora de áudio (mínimo de 10 s por requisição).
GROQ_AUDIO_PRICE_USD_PER_HOUR=
GROQ_VISION_PRICE_USD_PER_REQUEST=
BRAVE_PRICE_USD_PER_1000_REQUESTS=

# ─── Schedulers ───
# Lembretes de fechamento/vencimento: janela local de envio e intervalo.
PROACTIVE_SCHEDULER_INTERVAL_MS=900000
PROACTIVE_REMINDER_HOUR=9
PROACTIVE_QUIET_HOUR_START=21
